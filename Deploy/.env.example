# Configura un token distinto por usuario. No subas el archivo .env real.
DFS_USERS='{"demo":"REEMPLAZAR_TOKEN_DEMO"}'
DFS_USER_PASSWORDS='{"admin":"CAMBIAR_PASSWORD_ADMIN","demo":"CAMBIAR_PASSWORD_DEMO"}'
DFS_USER_ROLES='{"admin":"admin","demo":"usuario"}'
DFS_AUTH_USERS_FILE=/app/metadata/usuarios.json
DFS_PUBLIC_HOST=dfs.tudominio.com
DFS_DEFAULT_USER=demo
DFS_ADMIN_TOKEN=REEMPLAZAR_TOKEN_ADMIN
DFS_NODE_TOKEN=REEMPLAZAR_TOKEN_INTERNO
DFS_NODE1_STORAGE_KEY=REEMPLAZAR_BASE64_AES256_NODO1
DFS_NODE2_STORAGE_KEY=REEMPLAZAR_BASE64_AES256_NODO2
DFS_NODE3_STORAGE_KEY=REEMPLAZAR_BASE64_AES256_NODO3
